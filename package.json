{
  "name": "rsvp",
  "version": "0.1.0",
  "private": true,
  "description": "Surprisal-paced RSVP reader that runs entirely in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "vitest run --config vitest.slow.config.ts --silent=false",
    "reference": ".venv/Scripts/python scripts/reference_surprisal.py && .venv/Scripts/python scripts/reference_surprisal.py --model distilgpt2",
    "smoke": "vite build && node scripts/smoke.mjs",
    "lint:chars": "node scripts/escape-invisible.mjs --check src test",
    "smoke:pdf": "vite build && node scripts/smoke-pdf.mjs",
    "smoke:url": "node scripts/smoke-url.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mozilla/readability": "^0.6.0",
    "idb-keyval": "^6.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
